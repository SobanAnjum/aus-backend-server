{
  "name": "aus-api-server",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.js",
    "start": "node dist/server.js",
    "heroku-postbuild": "npm run build",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "firebase-admin": "^14.5.0",
    "pg": "^8.22.0",
    "resend": "^6.22.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/multer": "^2.2.0",
    "@types/ws": "^8.18.2"
  }
